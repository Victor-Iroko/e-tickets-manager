# Server & Application
NODE_ENV=development
BETTER_AUTH_SECRET=your_super_secret_better_auth_key_min_16_chars
BETTER_AUTH_URL=http://localhost:3000

# Database (PostgreSQL / Neon)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/e_tickets_manager
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5433/e_tickets_manager_test

# Paystack Payment Gateway
PAYSTACK_SECRET_KEY=sk_test_xxx

# Storage (Cloudinary)
CLOUDINARY_URL=cloudinary://key:secret@cloud_name

# Email (Nodemailer / Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Error Monitoring (Sentry)
SENTRY_DSN=https://xxx@sentry.io/xxx
